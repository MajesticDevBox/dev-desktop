# Copy to .env and adjust. Everything is optional.

# Folder that contains your git repos (as seen by the host). Forward slashes are fine on Windows.
REPOS_PATH=G:/Github Repos

# Host port for the dashboard (bound to 127.0.0.1)
PORT=7070

# GitHub PRs / issues / CI status. Fine-grained or classic token with read access
# (repo + actions:read). Without it only public repos work, with a low rate limit.
GITHUB_TOKEN=
# Different token per org/user (owner=token, comma separated). Used instead of GITHUB_TOKEN for that owner.
# Tokens are scoped to one owner, so list one per org, e.g. GITHUB_TOKENS=my-org=ghp_xxx,other-org=github_pat_yyy
GITHUB_TOKENS=

# A repo with a commit newer than this many days is auto-marked "active" when first discovered
ACTIVE_WINDOW_DAYS=30

# Refresh intervals (seconds)
GIT_REFRESH_SECONDS=60
DOCKER_REFRESH_SECONDS=5
HEALTH_REFRESH_SECONDS=30
GITHUB_REFRESH_SECONDS=300
RESCAN_SECONDS=300
